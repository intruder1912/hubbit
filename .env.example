# Settings for this computer. Copy this file to ".env" (same folder) and adjust,
# or let "uv run boost-scan --save" write the hub address for you.
# .env is not committed: every computer has its own.
# A variable set in your shell (export / setx) wins over this file.

# The Move Hub to use. Found by "uv run boost-scan".
#   Linux / Windows: the Bluetooth MAC, e.g. 00:16:53:AB:CD:EF
#   macOS: a UUID that only works on this Mac
# It picks the right hub when several are around and skips the extra scan.
# You still press the green button before each connection.
# BOOST_HUB_ADDRESS=00:16:53:AB:CD:EF

# Language of the console, the button window and the German missions' messages: en or de
# BOOST_LANG=de
