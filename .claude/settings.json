{
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv lock:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run boost-scan:*)",
      "Bash(uv run boost-console:*)",
      "Bash(uv run experiments/:*)",
      "Bash(uv run kids/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh label list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)"
    ],
    "ask": [
      "Bash(gh api:*)",
      "Bash(gh label create:*)",
      "Bash(gh label edit:*)",
      "Bash(gh label delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push origin --delete:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin +:*)",
      "Bash(git push * --force:*)",
      "Bash(git push * -f:*)"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "codeload.github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com"
      ]
    },
    "excludedCommands": [
      "gh *",
      "uv run boost-scan *",
      "uv run boost-scan",
      "uv run boost-console *",
      "uv run boost-console",
      "uv run experiments/*",
      "uv run kids/*"
    ]
  }
}
